# No modo local, basta npm ci, npm run build e npm start.
PORT=8080
HOST=127.0.0.1
# Produção: domínio com HTTPS; deve corresponder ao Host recebido.
# PUBLIC_URL=https://monitoramento.suaempresa.com
# NODE_ENV=production
# TRUST_PROXY=1
FOXOPS_DATABASE=foxops.sqlite3

# As chaves próprias de OpenAI, Claude, Grok, DeepSeek e Gemini são cadastradas
# pelo proprietário em Configurações > Inteligência artificial.
# O arquivo mestre de proteção é gerado automaticamente fora do banco.
# FOXOPS_AI_KEY_FILE=/caminho/persistente/.secrets/ai-master.key
# Opcional: OpenAI compartilhada da plataforma para quem selecionar esse modo.
# OPENAI_API_KEY=
# OPENAI_MODEL=

# Opcional: notificações de alertas (destino controlado pelo administrador).
# ALERT_WEBHOOK_URL=https://seu-destino.example/webhook

# Opcional: cobrança recorrente. Configure três preços recorrentes na Stripe.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_STARTER=
# STRIPE_PRICE_GROWTH=
# STRIPE_PRICE_MSP=

# A antiga rota administrativa global fica desativada por padrão.
# Não configure FOXOPS_ADMIN_TOKEN em produção.

# Administradores globais da identidade visual. Não concede acesso aos dados dos clientes.
# FOXOPS_PLATFORM_ADMIN_EMAILS=administrador@suaempresa.com
