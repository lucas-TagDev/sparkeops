{
  "name": "sparkeops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server.ts",
    "ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "check": "npm run typecheck && npm run build && npm test",
    "test": "node --test tests/node/*.test.ts",
    "typecheck": "tsc --noEmit",
    "backup": "node --env-file-if-exists=.env scripts/backup.ts",
    "mcp:check": "node --env-file-if-exists=.env scripts/mcp-client.ts",
    "package:linux": "node scripts/package-release.mjs"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.7.0",
    "prettier": "^3.9.10",
    "simple-icons": "^16.36.0",
    "typescript": "^5.8.0",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.3.0",
    "lucide-react": "^1.63.0",
    "nodemailer": "^10.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ssh2": "^1.17.0",
    "stripe": "^23.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.6"
  }
}
